{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@spotify/client": ["rn-lib/src/index.ts"],
      "@spotify/client/*": ["rn-lib/src/*"],

      "@core/config": ["packages/typescript/core-config/src/index.ts"],
      "@core/config/*": ["packages/typescript/core-config/src/*"],

      "@core/constants": ["packages/typescript/core-constants/src/index.ts"],
      "@core/constants/*": ["packages/typescript/core-constants/src/*"],

      "@core/domain": ["packages/typescript/core-domain/src/index.ts"],
      "@core/domain/*": ["packages/typescript/core-domain/src/*"],

      "@core/dto": ["packages/typescript/core-dto/src/index.ts"],
      "@core/dto/*": ["packages/typescript/core-dto/src/*"],

      "@core/logger": ["packages/typescript/core-logger/src/index.ts"],
      "@core/logger/*": ["packages/typescript/core-logger/src/*"],

      "@http/client": ["packages/typescript/http-client/src/index.ts"],
      "@http/client/*": ["packages/typescript/http-client/src/*"],

      "@keychain/service": ["packages/typescript/keychain-service/src/index.ts"],
      "@keychain/service/*": ["packages/typescript/keychain-service/src/*"],

      "@test/utils": ["packages/typescript/test-utils/src/index.ts"],
      "@test/utils/*": ["packages/typescript/test-utils/src/*"],

      "@feature-now-playing/*": ["packages/feature-now-playing/src/*"],

      "RnSample/*": ["apps/RnSample/src/*"],

      "RnModuleSpotifyClient/*": ["apps/RnModuleSpotifyClient/src/*"],
    }
  }
}
